# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=

# Базовый URL, по которому FastAPI-сервер доступен извне
# Например: https://your-domain.com
# ВАЖНО: URL должен быть HTTPS — Telegram Web App не работает по HTTP
WEBAPP_URL=

# Telegram ID администраторов (через запятую)
# Эти пользователи автоматически получают роль admin при регистрации
# Пример: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Порт для FastAPI-сервера (по умолчанию 8000)
# PORT=8000
